<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.contentstudio.asistent.host" ExtensionBundleVersion="0.10.148" ExtensionBundleName="Asistent Host"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.contentstudio.asistent.host" Version="0.9.45" />
    <Extension Id="com.contentstudio.asistent.folders" Version="0.10.148" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[15.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <!-- Invisible background extension: starts with Premiere and does the one thing the UXP panel cannot, putting an
         SRT on a caption track (Sequence.createCaptionTrack exists only in ExtendScript). Same pattern as Quick Search. -->
    <Extension Id="com.contentstudio.asistent.host">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
            <Event>applicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry>
            <Size><Height>1</Height><Width>1</Width></Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <!-- The Asistent Folders panel (0.10.145): a visible CEP panel, because Premiere's UXP panels get an empty drop from Finder and
         a CEP panel gets the dropped folder's path. Window > Extensions > Asistent Folders. -->
    <Extension Id="com.contentstudio.asistent.folders">
      <DispatchInfo>
        <Resources>
          <MainPath>./folders.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Asistent Folders</Menu>
          <Geometry>
            <Size><Height>300</Height><Width>320</Width></Size>
            <MinSize><Height>80</Height><Width>140</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
